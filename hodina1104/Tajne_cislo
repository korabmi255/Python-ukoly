import random

tajne_cislo = random.randint(1, 20)
pokusy = 0

print("Myslím si číslo od 1 do 20. Máš 5 pokusů!")

while pokusy < 5:   
  tip = int(input("Zadej svůj tip: "))


  if tip < 1 or tip > 20:
    print("Zadal jsi číslo mimo rozsah (1–20)!")
    continue  # špatný tip 

  pokusy += 1  #dobrý tip


  if tip < tajne_cislo:
    print("Moje číslo je VĚTŠÍ!")
  elif tip > tajne_cislo:
    print("Moje číslo je MENŠÍ!")
  else:
    print(f"Gratuluji! Uhodl jsi číslo na {pokusy}. pokus.")
    break
else:
  if tip != tajne_cislo:
    print(f"Bohužel ti došly pokusy! Tajné číslo bylo {tajne_cislo}.")